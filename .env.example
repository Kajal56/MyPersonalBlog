# Add these environment variables in Vercel dashboard (and backend/.env locally)

# --- Region alignment (latency) ---
# Vercel: vercel.json sets regions to sin1 (Singapore).
# Neon: create or keep your project in AWS ap-southeast-1 (Singapore).
# Both should be in the same region so API ↔ DB hops stay local.

# --- Neon PostgreSQL (Prisma) ---
# DATABASE_URL: pooled connection (-pooler host) for the running app (serverless).
# DIRECT_URL: direct connection (no -pooler) for migrations / prisma db push only.
#
# Neon dashboard (optional but helps cold starts):
#   Settings → Compute → disable "Scale to zero" or shorten suspend delay (paid tiers).

DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXX.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# Backend Environment
NODE_ENV=production
PORT=5000

# Frontend Environment
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=Personal Blog
